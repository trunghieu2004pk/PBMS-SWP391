PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=pbms
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string
# Hạn token (client tự đăng xuất khi hết hạn + sau 30' không hoạt động)
JWT_EXPIRES_IN=1d

CLIENT_URL=http://localhost:5173

# Admin đầu tiên (dùng cho: npm run create-admin --prefix server)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULLNAME=System Administrator
ADMIN_EMAIL=

# Quên mật khẩu qua email — cần SMTP. Gmail: bật 2FA rồi tạo "App password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PBMS <no-reply@pbms.local>
RESET_TOKEN_TTL_MINUTES=60

# Đăng nhập Google — OAuth 2.0 Client ID (Web) từ Google Cloud Console.
# Phải trùng VITE_GOOGLE_CLIENT_ID ở client.
GOOGLE_CLIENT_ID=

# payOS — cổng thanh toán (BẮT BUỘC khi dùng payment: phí đặt chỗ, checkout, vé tháng)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/staff?payment=return
PAYOS_CANCEL_URL=http://localhost:5173/staff?payment=cancel

# Kiosk cổng tự phục vụ (endpoint /api/gates/scan) — header X-Kiosk-Key
KIOSK_API_KEY=

# Job nền dọn đặt chỗ (điểm yếu 3.3) — đều tùy chọn, có mặc định
# Đơn pending quá ngần này (phút) chưa thanh toán → tự hủy + nhả slot (mặc định 15)
BOOKING_PENDING_TTL_MINUTES=15
# Đặt chỗ confirmed quá end_time + ngần này (phút) không check-in → no_show + nhả slot (mặc định 15)
BOOKING_NO_SHOW_GRACE_MINUTES=15
